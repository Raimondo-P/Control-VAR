 year = {1980}
}


@Article{Hanson2015,
  author    = {Samuel G. Hanson and Jeremy C. Stein},
  journal   = {Journal of Financial Economics},
  title     = {Monetary policy and long-term real rates},
  year      = {2015},
  month     = {mar},
  number    = {3},
  pages     = {429--448},
  volume    = {115},
  abstract  = {Changes in monetary policy have surprisingly strong effects on forward real rates in the distant future. A 100 basis point increase in the two-year nominal yield on a Federal Open Markets Committee announcement day is associated with a 42 basis point increase in the ten-year forward real rate. This finding is at odds with standard macro-models based on sticky nominal prices, which imply that monetary policy cannot move real rates over a horizon longer than that over which all prices in the economy can readjust. Instead, the responsiveness of long-term real rates to monetary shocks appears to reflect changes in term premia. One mechanism that could generate such variation in term premia is based on demand effects due to the existence of what we call yield-oriented investors. We find some evidence supportive of this channel.},
  date      = {2014-11-13},
  day       = {13},
  doi       = {10.1016/j.jfineco.2014.11.001},
  file      = {:D\:/DID SVAR2303/references/monetary_policy_and_real_rates_jfe_2015.pdf:PDF},
  keywords  = {Monetary policy transmission; Long-term real rates; Reaching-for-yield},
  publisher = {Elsevier {BV}},
}

@Article{Angrist2017,
  author    = {Joshua D. Angrist and {Oscar Jorda} and Guido M. Kuersteiner},
  journal   = {Journal of Business \& Economic Statistics},
  title     = {Semiparametric Estimates of Monetary Policy Effects: String Theory Revisited},
  year      = {2017},
  month     = {may},
  number    = {3},
  pages     = {371--387},
  volume    = {36},
  abstract  = {We develop flexible semiparametric time series methods for the estimation of the causal effect of monetary policy on macroeconomic aggregates. Our estimator captures the average causal response to discrete policy interventions in a macrodynamic setting, without the need for assumptions about the process generating macroeconomic outcomes. The proposed estimation strategy, based on propensity score weighting, easily accommodates asymmetric and nonlinear responses. Using this estimator, we show that monetary tightening has clear effects on the yield curve and on economic activity. Monetary accommodation, however, appears to generate less pronounced responses from both. Estimates for recent financial crisis years display a similarly dampened response to monetary accommodation.},
  doi       = {10.1080/07350015.2016.1204919},
  file      = {:D\:/DID SVAR2303/references/Semiparametric Estimates of Monetary Policy Effects String Theory Revisited.pdf:PDF},
  keywords  = {Local projections, Nonlinear impulse response functions, Propensity score, Semiparametric models, Vector autoregression},
  publisher = {Informa {UK} Limited},
}

@Article{Olea2021,
  author    = {Jos{\'{e}} L. Montiel Olea and James H. Stock and Mark W. Watson},
  journal   = {Journal of Econometrics},
  title     = {Inference in Structural Vector Autoregressions identified with an external instrument},
  year      = {2021},
  month     = {nov},
  number    = {1},
  pages     = {74--87},
  volume    = {225},
  abstract  = {This paper studies Structural Vector Autoregressions in which a structural shock of interest (e.g., an oil supply shock) is identified using an external instrument. The external instrument is taken to be correlated with the target shock (the instrument is relevant) and to be uncorrelated with other shocks of the model (the instrument is exogenous). The potential weak correlation between the external instrument and the target structural shock compromises the large-sample validity of standard inference. We suggest a confidence set for impulse response coefficients that is not affected by the instrument strength (i.e., is weak-instrument robust) and asymptotically coincides with the standard confidence set when the instrument is strong.},
  doi       = {10.1016/j.jeconom.2020.05.014},
  file      = {:D\:/DID SVAR2303/references/SVAR IV.pdf:PDF},
  keywords  = {target structural shock compromises the large-sample validity of standard inference. Narrative approach We suggest a confidence set for impulse response coefficients that is not affected by Instrumental variables the instrument strength (i.e., is weak-instrument robust) and asymptotically coincides Weak identification with the standard confidence set when the instrument is strong. Impulse response functions © 2020 Elsevier B.V. All rights reserved},

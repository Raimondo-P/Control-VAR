@article{goncalveskilian2004,
title = {Bootstrapping autoregressions with conditional heteroskedasticity of unknown form},
journal = {Journal of Econometrics},
volume = {123},
number = {1},
pages = {89-120},
year = {2004},
issn = {0304-4076},
doi = {https://doi.org/10.1016/j.jeconom.2003.10.030},
url = {https://www.sciencedirect.com/science/article/pii/S0304407603002847},
author = {Sı́lvia Gon\c{c}alves and Lutz Kilian},
keywords = {Bootstrap, Wild bootstrap, Autoregressions, Conditional heteroskedasticity},
abstract = {Conditional heteroskedasticity is an important feature of many macroeconomic and financial time series. Standard residual-based bootstrap procedures for dynamic regression models treat the regression error as i.i.d. These procedures are invalid in the presence of conditional heteroskedasticity. We establish the asymptotic validity of three easy-to-implement alternative bootstrap proposals for stationary autoregressive processes with martingale difference errors subject to possible conditional heteroskedasticity of unknown form. These proposals are the fixed-design wild bootstrap, the recursive-design wild bootstrap and the pairwise bootstrap. In a simulation study all three procedures tend to be more accurate in small samples than the conventional large-sample approximation based on robust standard errors. In contrast, standard residual-based bootstrap methods for models with i.i.d. errors may be very inaccurate if the i.i.d. assumption is violated. We conclude that in many empirical applications the proposed robust bootstrap procedures should routinely replace conventional bootstrap procedures for autoregressions based on the i.i.d. error assumption.}
}

